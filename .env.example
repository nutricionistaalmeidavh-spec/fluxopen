# Copy to .env, generate unique values: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
SCAN_SIGNING_SECRET=CHANGE_ME_TO_A_DISTINCT_RANDOM_48_CHARACTER_SECRET
# github (remote GitHub Actions) or local (self-hosted Docker engine)
SCAN_BACKEND=github
GH_REPO=nutricionistaalmeidavh-spec/fluxopen
GH_REF=main
# Fine-grained personal access token: repository Actions: write, Actions: read
GH_TOKEN=
# Set true behind HTTPS. Keep false ONLY for local testing.
COOKIE_SECURE=false
